fwd_add() {
  local lp pp t h tp pr e def
  ask_port lp "本机监听端口（NAT 内网端口）"
  ask_pub pp "对应的 NAT 公网端口" "$lp"
  while :; do
    ask t "目标 地址:端口（如 land.example.com:20001）"
    case "$t" in *:*) h="${t%:*}"; tp="${t##*:}" ;; *) h="$t"; tp=443 ;; esac
    is_host "$h" && is_port "$tp" && break
    err "目标无效（支持 IPv4 或域名）"
  done
  ask_proto pr
  if nft_usable; then def=1; else def=2; fi
  say "  1) nftables 内核转发（零内存、性能最好）  2) Xray 用户态（域名每次连接实时解析）"
  ask e "转发引擎" "$def"
  if [ "$e" = "1" ]; then
    nft_usable || { err "本机 nftables 不可用，请选 2"; return 1; }
    e="nft"
  else
    e="xray"
  fi
  txn_begin
  st_set '.relay.forwards += [{listen: $lp, public: $pp, target_host: $h, target_port: $tp, proto: $pr, engine: $e}]' \
    --argjson lp "$lp" --argjson pp "$pp" --arg h "$h" --argjson tp "$tp" --arg pr "$pr" --arg e "$e" \
    && txn_commit && ok "已添加 :$lp -> $h:$tp" && fwd_hint "$pp" "$h"
}

fwd_del() {
  local p
  fwd_list
  ask p "要删除的本机监听端口"
  is_port "$p" || return 0
  txn_begin
  st_set '.relay.forwards |= map(select(.listen != $p))' --argjson p "$p" && txn_commit && ok "已删除 :$p"
}

fwd_menu() {
  local c st
  while :; do
    if nft_usable; then st="可用"; else st="不可用"; fi
    line
    say "${G}44. 端口转发${N}（nftables: $st）"
    fwd_list
    say " 1. 添加规则    2. 删除规则    3. 立即刷新域名解析    0. 返回"
    ask c "选择" "0"
    case "$c" in
      1) fwd_add ;;
      2) fwd_del ;;
      3) apply && ok "已刷新" ;;
      *) return 0 ;;
    esac
  done
}

# ---------------------------------------------------------------- 中转：22 RproxyS

rps_setup() {
  local d cur lp pp u
  [ -s "$CERT" ] || { warn "RproxyS 需要证书（RproxyC 不允许跳过证书校验）"; cmd_cert || return 1; }
  while :; do
    d=$(st_get '.relay.rproxys.domain'); [ -z "$d" ] && d=$(cert_default_domain)
    ask d "RproxyS 隧道域名（须被证书覆盖，并解析到本中转 NAT 公网 IP）" "$d"
    if is_domain "$d" && cert_covers "$CERT" "$d"; then break; fi
    err "域名无效或不在证书范围内（SAN: $(cert_sans "$CERT" | tr '\n' ' ')）"
  done
  cur=$(st_get '.relay.rproxys | select(.enabled == true) | .listen_port')
  ask_port lp "隧道监听端口（NAT 内网端口）" "${cur:-20000}" "$cur"
  ask_pub pp "对应的 NAT 公网端口" "$lp"
  u=$(st_get '.relay.rproxys.uuids[0]'); [ -z "$u" ] && u=$(new_uuid)
  while :; do ask u "隧道 UUID" "$u"; is_uuid "$u" && break; err "UUID 无效"; done
  txn_begin
  st_set '.relay.rproxys |= (. + {enabled: true, domain: $d, listen_port: $lp, public_port: $pp, uuids: [$u]})' \
    --arg d "$d" --argjson lp "$lp" --argjson pp "$pp" --arg u "$u" && txn_commit && ok "RproxyS 已启用" && rps_show
}

rps_add_map() {
  local p pp pr
  st_true '.relay.rproxys.enabled' || { err "请先启用 RproxyS"; return 1; }
  ask_port p "映射端口（本机监听，同时作为 RproxyC 的 extPort）"
  ask_pub pp "对应的 NAT 公网端口（外部访问用）" "$p"
  ask_proto pr
  txn_begin
  st_set '.relay.rproxys.mappings += [{port: $p, public: $pp, proto: $pr}]' --argjson p "$p" --argjson pp "$pp" --arg pr "$pr" \
    && txn_commit && ok "已添加映射 :$p"
}

rps_del_map() {
  local p
  ask p "要删除的映射端口"
  is_port "$p" || return 0
  txn_begin
  st_set '.relay.rproxys.mappings |= map(select(.port != $p))' --argjson p "$p" && txn_commit && ok "已删除 :$p"
}

rps_show() {
  st_true '.relay.rproxys.enabled' || { say "  RproxyS 未启用"; return 0; }
  line; say "${G}[22] RproxyS（de_GWD client RproxyC 填写）${N}"
  say "  隧道地址: ${Y}$(addr_of "$(st_get '.relay.rproxys.domain')" "$(st_get '.relay.rproxys.public_port')")${N}"
  say "  隧道 UUID: ${Y}$(st_get '.relay.rproxys.uuids[0]')${N}"
  jq -r --arg h "$(st_get '.public_host')" '.relay.rproxys.mappings[]? |
    "  映射: extPort=\(.port) extProtocol=\(.proto)    外部访问 \($h):\(.public)"' "$STATE"
}

rps_menu() {
  local c
  while :; do
    line
    say "${G}22. RproxyS 反向代理${N}"
    rps_show
    say " 1. 启用 / 修改隧道    2. 添加映射端口    3. 删除映射端口    4. 停用 RproxyS    0. 返回"
    ask c "选择" "0"
    case "$c" in
      1) rps_setup ;;
      2) rps_add_map ;;
      3) rps_del_map ;;
      4) txn_begin; st_set '.relay.rproxys.enabled = false' && txn_commit && ok "RproxyS 已停用" ;;
      *) return 0 ;;
    esac
  done
}

# ---------------------------------------------------------------- 节点 / 状态 / 刷新

cmd_node() {
  local role dom host pp path addr ep u
  [ -f "$STATE" ] || { err "尚未安装"; return 1; }
  role=$(st_get '.role')
  host=$(st_get '.public_host')
  if [ "$role" = "landing" ]; then
    dom=$(st_get '.domain'); pp=$(st_get '.landing.public_port'); path=$(st_get '.landing.path')
    addr=$(addr_of "$host" "$pp")
    ep=$(printf '%s' "$path" | sed 's#/#%2F#g')
    line
    say "${G}de_GWD client 主线节点（VLESS + XHTTP + TLS）${N}"
    say "  domain : ${Y}$addr${N}"
    [ "$host" != "$dom" ] && say "  tls    : ${Y}$dom${N}   ← 在 client 节点页的 tls 按钮中填写"
    say "  path   : ${Y}$path${N}"
    for u in $(st_get '.landing.uuids[]'); do
      say "  UUID   : ${Y}$u${N}"
      say "  链接   : vless://$u@$host:$pp?encryption=none&security=tls&sni=$dom&alpn=h2&type=xhttp&path=$ep&mode=packet-up#des-$dom"
    done
    show_extras
  else
    line
    say "${G}[44] 端口转发${N}   中转地址: $host"
    fwd_list
    jq -r '.relay.forwards[]? | "\(.public) \(.target_host)"' "$STATE" | while read -r pp u; do fwd_hint "$pp" "$u"; done
    rps_show
  fi
  line
}

rss_mb() {
  local t=0 p k
  for p in $(pgrep -x "$1" 2>/dev/null); do
    k=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)
    t=$((t + ${k:-0}))
  done
  echo $((t / 1024))
}

cmd_status() {
  local role
  role=$(st_get '.role')
  line
  say "des $VERSION    角色: ${Y}${role:-未安装}${N}    Xray: $("$XRAY_BIN" version 2>/dev/null | awk 'NR==1{print $2}')"
  say "系统: $OS_PKG / $OS_INIT"
  say "des-xray: $(svc_state des-xray) ($(rss_mb xray)MB)    des-nft: $(svc_state des-nft)    定时刷新: $(svc_state "$(refresh_unit)")"
  say "内存上限: $(mem_mb)MB    GOMEMLIMIT: $(grep -ho 'GOMEMLIMIT=[^ ]*' /etc/conf.d/des-xray /etc/systemd/system/des-xray.service 2>/dev/null | head -n1 | cut -d= -f2 | tr -d '"')"
  free -m 2>/dev/null | awk 'NR<=2'
  [ -s "$CERT" ] && say "证书: $(cert_sans "$CERT" | tr '\n' ' ')  到期 $(cert_end "$CERT")"
  line
}

cmd_refresh() {
  lock quiet
  [ -f "$XRAY_LOG" ] && [ "$(wc -c <"$XRAY_LOG")" -gt 1048576 ] && : >"$XRAY_LOG"
  [ -f "$STATE" ] || exit 0
  [ "$(st_get '.role')" = "relay" ] || exit 0
  render_nft >"$NFT_CONF.new" 2>/dev/null || { rm -f "$NFT_CONF.new"; exit 0; }
  if cmp -s "$NFT_CONF.new" "$NFT_CONF"; then
    rm -f "$NFT_CONF.new"
  elif nft -c -f "$NFT_CONF.new" >/dev/null 2>&1; then
    mv -f "$NFT_CONF.new" "$NFT_CONF" && nft -f "$NFT_CONF" && logger -t des "nft 转发目标解析已更新"
  else
    rm -f "$NFT_CONF.new"
  fi
  exit 0
}

# ---------------------------------------------------------------- 菜单

menu() {
  local role c
  while :; do
    role=$(st_get '.role')
    say ""
    say "${G}===================== des $VERSION =====================${N}"
    say " 角色: ${Y}${role:-未安装}${N}    des-xray: $(svc_state des-xray)    des-nft: $(svc_state des-nft)"
    [ -s "$CERT" ] && say " 证书到期: $(cert_end "$CERT")"
    say "${G}====================================================${N}"
    say " 1.  安装 / 重新安装（落地 / 中转）"
    say " 3.  导入 / 更新 SSL 证书"
    if [ "$role" = "landing" ]; then
      say " 5.  主节点 UUID / path / 地址"
      say " 55. 附加协议（Reality / SOCKS5）"
    elif [ "$role" = "relay" ]; then
      say " 44. 端口转发"
      say " 22. RproxyS 反向代理"
    fi
    say " 11. 打印节点信息"
    say " 7.  运行状态"
    say " 0.  更新 Xray 核心      00. 更新 des 脚本"
    say " 99. 卸载                q.  退出"
    ask c "选择" "q"
    case "$c" in
      1)  cmd_install ;;
      3)  cmd_cert ;;
      5)  [ "$role" = "landing" ] && main_menu_landing ;;
      55) [ "$role" = "landing" ] && extras_menu ;;
      44) [ "$role" = "relay" ] && fwd_menu ;;
      22) [ "$role" = "relay" ] && rps_menu ;;
      11) cmd_node; pause ;;
      7)  cmd_status; pause ;;
      0)  cmd_update_xray ;;
      00) cmd_selfupdate ;;
      99) cmd_uninstall ;;
      q|Q) exit 0 ;;
      *)  err "无效选择" ;;
    esac
  done
}

main() {
  detect_os
  case "${1-}" in
    refresh)      cmd_refresh ;;
    node)         cmd_node ;;
    status)       cmd_status ;;
    install)      check_env; lock; cmd_install ;;
    cert)         check_env; need_pkgs openssl:openssl jq:jq; lock; shift; cmd_cert "$@" ;;
    apply)        check_env; lock; apply && ok "已应用" ;;
    update-xray)  check_env; lock; cmd_update_xray ;;
    update)       check_env; cmd_selfupdate ;;
    uninstall)    check_env; lock; cmd_uninstall ;;
    ''|menu)
      check_env; need_pkgs curl:curl jq:jq openssl:openssl; lock
      [ -f "$STATE" ] || { info "尚未安装，进入安装流程"; cmd_install; }
      menu ;;
    -v|--version) echo "des $VERSION" ;;
    *) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  esac
}

main "$@"
